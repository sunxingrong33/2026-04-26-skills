{
  "name": "SAR Atlas",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements-agent.txt",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8766],
  "portsAttributes": {
    "8766": {"label": "SAR Atlas 工作台", "onAutoForward": "openBrowser"}
  }
}
